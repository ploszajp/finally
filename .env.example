# Copy to .env and fill in. Passed to the container with --env-file;
# the backend reads only process environment variables.

# Required for AI chat: OpenRouter API key
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: Massive (Polygon.io) API key for real market data.
# Leave empty to use the built-in market simulator.
MASSIVE_API_KEY=

# Optional: "true" returns deterministic mock LLM responses (tests, no API key)
LLM_MOCK=false
